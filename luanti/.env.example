# Kopieren nach .env und anpassen:  cp .env.example .env

# Luanti-Server-Version (Docker-Tag). Clients sollten dieselbe Version haben.
LUANTI_VERSION=5.18.0

# Externer UDP-Port (im Client als Port angeben)
LUANTI_PORT=30000

# Name des Welt-Ordners unter data/worlds/
WORLD_NAME=welt

# Benutzer-/Gruppen-ID, der die Dateien in ./data gehören sollen (`id` zeigt sie an)
PUID=1000
PGID=1000

TZ=Europe/Berlin
